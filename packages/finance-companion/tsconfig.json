{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client", "vitest/globals"],
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*", "vite.config.mts"],
  "exclude": ["dist", "node_modules"]
}
